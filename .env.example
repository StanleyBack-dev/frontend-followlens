# =====================================================================
# FollowLens — Frontend (Next.js BFF)
# Copie para `.env.local`. Em produção configure na Vercel.
# Nenhuma variável aqui é NEXT_PUBLIC: todas ficam só no servidor.
# =====================================================================

# URL do backend NestJS (server-to-server)
BACKEND_URL=http://localhost:4000

# Mesma chave do backend (INTERNAL_API_KEY)
INTERNAL_API_KEY=

# Nome do cookie de sessão (httpOnly)
SESSION_COOKIE_NAME=fl_session

# Fuso usado para exibir datas
APP_TIMEZONE=America/Sao_Paulo

# Google OAuth Client ID (público — identifica o app no Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
